{
  "info": {
    "name": "Cinema Ticketing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE", "value": "http://localhost:3000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{BASE}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "  pm.collectionVariables.set('access_token', res.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{BASE}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "  pm.collectionVariables.set('access_token', res.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{BASE}}/api/v1/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "  pm.collectionVariables.set('access_token', res.data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{BASE}}/api/v1/auth/logout",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Showtimes",
      "item": [
        {
          "name": "Get All Showtimes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE}}/api/v1/showtimes?page=1&limit=10",
              "host": ["{{BASE}}"],
              "path": ["api", "v1", "showtimes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Showtime by ID",
          "request": {
            "method": "GET",
            "url": "{{BASE}}/api/v1/showtimes/:id",
            "variable": [{ "key": "id", "value": "" }]
          }
        },
        {
          "name": "Create Showtime",
          "request": {
            "method": "POST",
            "url": "{{BASE}}/api/v1/showtimes",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movie_title\": \"Inception\",\n  \"start_time\": \"2026-07-01T10:00:00Z\",\n  \"end_time\": \"2026-07-01T12:00:00Z\",\n  \"price\": 50000,\n  \"total_seats\": 100\n}"
            }
          }
        },
        {
          "name": "Update Showtime",
          "request": {
            "method": "PUT",
            "url": "{{BASE}}/api/v1/showtimes/:id",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movie_title\": \"Inception 2\",\n  \"price\": 75000\n}"
            },
            "variable": [{ "key": "id", "value": "" }]
          }
        },
        {
          "name": "Delete Showtime",
          "request": {
            "method": "DELETE",
            "url": "{{BASE}}/api/v1/showtimes/:id",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "variable": [{ "key": "id", "value": "" }]
          }
        }
      ]
    }
  ]
}
